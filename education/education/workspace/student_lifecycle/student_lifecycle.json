 "content": "[{\"id\":\"sl_intro\",\"type\":\"paragraph\",\"data\":{\"text\":\"<b>Each new year:</b> 1) collect applications &nbsp;2) check <i>Enrollment Diagnostics</i> &nbsp;3) enroll with the <i>Program Enrollment Tool</i> (upload the section roster) &nbsp;4) roll over Student Groups &nbsp;5) create logins with the <i>Student User Creation Tool</i> &nbsp;6) record leavers and graduates as <i>Student Exits</i>.\",\"col\":12}},{\"id\":\"sl_head1\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Tools &amp; Records</b></span>\",\"col\":12}},{\"id\":\"sl_sc0\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Program Enrollment Tool\",\"col\":3}},{\"id\":\"sl_sc1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Student User Creation Tool\",\"col\":3}},{\"id\":\"sl_sc2\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Enrollment Diagnostics\",\"col\":3}},{\"id\":\"sl_sc3\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Enrollment Statistics\",\"col\":3}},{\"id\":\"sl_sc4\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Student Applicant\",\"col\":3}},{\"id\":\"sl_sc5\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Student Exit\",\"col\":3}},{\"id\":\"sl_sc6\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Not Promoted Student\",\"col\":3}},{\"id\":\"sl_sc7\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"External Exam Result\",\"col\":3}},{\"id\":\"sl_sp\",\"type\":\"spacer\",\"data\":{\"col\":12}},{\"id\":\"sl_head2\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Everything Else</b></span>\",\"col\":12}},{\"id\":\"sl_card0\",\"type\":\"card\",\"data\":{\"card_name\":\"Enrolling a New Year\",\"col\":4}},{\"id\":\"sl_card1\",\"type\":\"card\",\"data\":{\"card_name\":\"Accounts\",\"col\":4}},{\"id\":\"sl_card2\",\"type\":\"card\",\"data\":{\"card_name\":\"Leaving & Exams\",\"col\":4}},{\"id\":\"sl_card3\",\"type\":\"card\",\"data\":{\"card_name\":\"Reports\",\"col\":4}},{\"id\":\"sl_card4\",\"t